{
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "Treino de hoje",
      "size": "extraLarge",
      "weight": "bolder"
    },
    {
      "type": "TextBlock",
      "text": "{plano} · {nivel}",
      "isSubtle": true
    },
    {
      "type": "okmigoProgresso",
      "rotulo": "Feito",
      "feito": "{feitos}",
      "de": "{total}"
    },
    {
      "type": "TextBlock",
      "text": "{feitos} de {total} exercícios",
      "size": "small",
      "isSubtle": true
    },
    {
      "type": "Container",
      "id": "perfil",
      "items": [
        {
          "type": "TextBlock",
          "text": "Seu perfil",
          "size": "medium",
          "weight": "bolder"
        },
        {
          "type": "Input.ChoiceSet",
          "id": "nivel",
          "label": "Nível",
          "style": "expanded",
          "isRequired": true,
          "value": "{nivel_valor}",
          "choices": [
            {
              "title": "Iniciante",
              "value": "iniciante",
              "okmigoNota": "até 6 meses",
              "okmigoIcone": "🌱"
            },
            {
              "title": "Intermediário",
              "value": "intermediario",
              "okmigoNota": "de 6 meses a 2 anos",
              "okmigoIcone": "🌿"
            },
            {
              "title": "Avançado",
              "value": "avancado",
              "okmigoNota": "mais de 2 anos",
              "okmigoIcone": "🌳"
            }
          ]
        },
        {
          "type": "Input.Number",
          "id": "dias",
          "label": "Dias por semana",
          "min": 1,
          "max": 7,
          "value": "{dias}"
        },
        {
          "type": "ActionSet",
          "okmigoRodape": true,
          "actions": [
            {
              "type": "Action.Submit",
              "title": "Salvar e escolher o foco",
              "style": "positive",
              "data": {
                "operacao": "guardar_perfil"
              },
              "okmigoAposEnviar": {
                "type": "Action.ToggleVisibility",
                "targetElements": [
                  {
                    "elementId": "perfil",
                    "isVisible": false
                  },
                  {
                    "elementId": "foco",
                    "isVisible": true
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "id": "foco",
      "isVisible": false,
      "items": [
        {
          "type": "TextBlock",
          "text": "Qual área hoje?",
          "size": "medium",
          "weight": "bolder"
        },
        {
          "type": "Container",
          "okmigoGrade": "compacta",
          "items": [
            {
              "_repetir_lista": {
                "type": "Container",
                "style": "emphasis",
                "id": "area_{id}",
                "selectAction": {
                  "type": "Action.ToggleVisibility",
                  "targetElements": [
                    {
                      "elementId": "detalhe_{id}",
                      "isVisible": true
                    }
                  ]
                },
                "items": [
                  {
                    "type": "TextBlock",
                    "text": "{icone} {nome}",
                    "weight": "bolder",
                    "horizontalAlignment": "center"
                  },
                  {
                    "type": "TextBlock",
                    "text": "{exercicios} exercícios",
                    "size": "small",
                    "isSubtle": true,
                    "horizontalAlignment": "center"
                  }
                ]
              }
            }
          ]
        },
        {
          "type": "Container",
          "okmigoGrade": "etiquetas",
          "items": [
            {
              "_repetir_lista": {
                "type": "TextBlock",
                "text": "{nome}"
              }
            }
          ]
        },
        {
          "type": "okmigoCronometro",
          "rotulo": "Descanso entre séries",
          "segundos": "{descanso_s}"
        },
        {
          "type": "ActionSet",
          "actions": [
            {
              "type": "Action.ToggleVisibility",
              "title": "‹ voltar ao perfil",
              "mode": "secondary",
              "targetElements": [
                {
                  "elementId": "foco",
                  "isVisible": false
                },
                {
                  "elementId": "perfil",
                  "isVisible": true
                }
              ]
            },
            {
              "type": "Action.Submit",
              "title": "Começar",
              "style": "positive",
              "data": {
                "operacao": "iniciar_treino"
              }
            },
            {
              "type": "Action.Submit",
              "title": "Encerrar treino",
              "style": "destructive",
              "data": {
                "operacao": "encerrar_treino"
              }
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "Este nó é ignorado de propósito (cor):",
      "color": "attention"
    },
    {
      "type": "ActionSet",
      "actions": [
        {
          "type": "Action.OpenUrl",
          "title": "Ver no site",
          "url": "https://exemplo.com"
        }
      ]
    },
    {
      "type": "Container",
      "items": [
        {
          "type": "TextBlock",
          "text": "Com quem",
          "weight": "bolder",
          "wrap": true
        },
        {
          "type": "Input.ChoiceSet",
          "id": "com_quem",
          "campo": "profissional",
          "label": "Quem acompanha",
          "okmigoQuemOpera": true,
          "style": "expanded"
        }
      ]
    }
  ]
}
