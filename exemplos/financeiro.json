{
  "type": "AdaptiveCard",
  "version": "1.5",
  "okmigoTema": "financeiro-violeta",
  "okmigoNavegacao": "inferior",
  "body": [
    {"type": "Container", "style": "accent", "items": [
      {"type": "TextBlock", "text": "Gasto total do mês", "size": "small"},
      {"type": "TextBlock", "text": "R$ {gasto_total}", "size": "extraLarge", "weight": "bolder"},
      {"type": "okmigoProgresso", "rotulo": "Orçamento mensal", "feito": "{gasto_total}", "de": "{orcamento}"}
    ]},

    {"type": "okmigoDistribuicao", "titulo": "Distribuição por categoria", "itens": [
      {"_repetir_lista": {"rotulo": "{nome}", "valor": "{gasto}", "texto": "{percentual}%", "tom": "{tom}"}}
    ]},

    {"type": "okmigoCartaoBancario", "cartoes": [
      {"_repetir_lista": {
        "id": "{id}", "titulo": "{titulo}", "tipo": "{tipo}", "bandeira": "{bandeira}", "numero": "{numero}",
        "tom": "{tom}", "fatura_rotulo": "Fatura atual", "fatura": "R$ {fatura}",
        "limite_rotulo": "Limite total", "limite": "R$ {limite}",
        "progresso_rotulo": "Limite utilizado", "progresso_texto": "R$ {disponivel} disponível",
        "progresso_feito": "{utilizado_pct}", "progresso_de": 100,
        "lancamentos": [
          {"_repetir_lista": {"icone": "{icone}", "titulo": "{titulo}", "subtitulo": "{categoria}",
                              "valor": "{valor}", "semantica": "{semantica}"},
           "_de": "lancamentos"}
        ]},
       "_de": "cartoes"}
    ]},

    {"type": "okmigoGrafico", "forma": "barras", "titulo": "Entradas × saídas",
     "series": [{"rotulo": "Entradas", "cor": "positivo"}, {"rotulo": "Saídas", "cor": "negativo"}],
     "pontos": [
       {"_repetir_lista": {"rotulo": "{mes}", "valores": ["{entradas}", "{saidas}"]}, "_de": "meses"}
     ]},

    {"type": "Table", "columns": [{"width": 3}, {"width": 1}, {"width": 1}],
     "rows": [
       {"type": "TableRow", "cells": [
         {"type": "TableCell", "items": [{"type": "TextBlock", "text": "Categoria", "weight": "bolder"}]},
         {"type": "TableCell", "items": [{"type": "TextBlock", "text": "No mês", "weight": "bolder"}]},
         {"type": "TableCell", "items": [{"type": "TextBlock", "text": "Variação", "weight": "bolder"}]}
       ]},
       {"_repetir_lista": {"type": "TableRow", "cells": [
         {"type": "TableCell", "items": [{"type": "TextBlock", "text": "{icone} {nome}"}]},
         {"type": "TableCell", "items": [{"type": "TextBlock", "text": "R$ {gasto}"}]},
         {"type": "TableCell", "items": [{"type": "TextBlock", "text": "{variacao}"}]}
       ]}}
     ]},

    {"type": "okmigoAutorizar", "rotulo": "Conectar outro banco", "url": "{url_autorizacao}",
     "motivo": "Você vai autorizar, na página do seu banco, a leitura das suas contas. Nenhuma senha passa por aqui."},

    {"type": "Image", "url": "https://terceiro.example/logo.png", "altText": "logo de terceiro (recusada)"}
  ]
}
